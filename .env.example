# ---------------------------------------------------------------------------
# CourageLoop — environment variables
#
# Copy to `.env` at the repo root for local development. `.env` is gitignored.
# One file, at the root, for every package: packages/api/src/env.ts and
# apps/client/app.config.ts each walk up to the directory holding
# pnpm-workspace.yaml and load the .env there, because pnpm runs scripts
# with the cwd set to the package. A variable already in the environment
# wins over this file, so CI can inject values with no .env present.
# Every variable is read in exactly one place: packages/api/src/config.ts
# (validated with zod at startup) or apps/client/app.config.ts.
# Never put a real value in this file.
# ---------------------------------------------------------------------------

# ----- API server (packages/api) --------------------------------------------

# Port the HTTP server listens on. Render and Cloud Run both inject PORT.
PORT=8080

# "development" | "test" | "production". Controls log level and Sentry.
NODE_ENV=development

# The browser origins allowed to call this API. Comma-separated, and these
# exact three — never a wildcard. `*` is rejected at boot, as is any entry with
# a trailing slash or a path, because either one fails later as a silent CORS
# refusal rather than as an error anyone sees.
#
# The hostnames of record:
#   courageloop.com      the public site and the clinician app (www redirects here)
#   app.courageloop.com  the client PWA, and the /join target in an invite link
#   api.courageloop.com  this API
#
# Outside production, http://localhost:5173 (web) and http://localhost:3000
# (clinician) are added automatically, so this line needs no editing for dev.
CORS_ORIGINS=https://courageloop.com,https://app.courageloop.com,https://api.courageloop.com

# Postgres connection string. Supabase: Project Settings → Database → URI
# (use the *pooler* URI in production; the direct URI for migrations).
# The role in this URL must NOT be the service role — it must be a role that
# is subject to row-level security. See docs/data-path.md.
DATABASE_URL=postgresql://ledger_api:password@localhost:5432/ledger

# Direct (non-pooled) URL used only by drizzle-kit for migrations. May equal
# DATABASE_URL in dev. Uses the migration role (see docs/data-path.md).
DATABASE_MIGRATE_URL=postgresql://postgres:password@localhost:5432/ledger

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Supabase JWT verification. Prefer the JWKS URL (asymmetric keys):
#   https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# If your project still issues HS256 tokens, set SUPABASE_JWT_SECRET instead
# (Project Settings → API → JWT Secret). Set one or the other, not both.
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=

# Which identity provider owns the auth user. One value today; the move to
# Google Cloud Identity Platform (go-live gate A2, Prompt 11) adds another and
# changes only this line plus the implementation in src/auth-admin.ts.
AUTH_PROVIDER=supabase

# Supabase service-role key. THE ONLY CREDENTIAL HERE THAT CAN ACT ON ANOTHER
# USER, and the only runtime use of a service-role key anywhere in this app.
# Read in exactly one place, packages/api/src/auth-admin.ts, for exactly one
# call: deleting the auth user when someone deletes their account. It never
# touches the application database — that connection is the ledger_api role,
# which has RLS enforced and no BYPASSRLS.
# Project Settings -> API -> service_role. Treat it like a root password.
# Required in production: the server refuses to boot without it, because a
# deployment that cannot honour a deletion request should not be running one.
SUPABASE_SERVICE_ROLE_KEY=

# How long a deleted account's rows are kept before the purge job destroys
# them. The window exists so a deletion made by mistake can still be undone
# from a backup; after it, nothing can recover them. Told to the client in
# those words on the Settings screen.
DELETION_GRACE_DAYS=30
# When the purge runs (node-cron). Nightly, off-peak.
CRON_PURGE_TICK=30 3 * * *

# Optional: PEM of a private CA to pin for the DB TLS connection (Cloud SQL).
DATABASE_CA_CERT=

# 32 random bytes, base64. Root key for field-level encryption of journal
# text, prediction text, prior labels, and body-state prose.
# Generate: openssl rand -base64 32
# Rotating: add FIELD_ENCRYPTION_KEY_V2 and bump FIELD_ENCRYPTION_KEY_VERSION;
# the rotate-keys job re-encrypts rows lazily. Never delete an old key while
# any row still references its version.
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEY_VERSION=1

# Anthropic API key. Used ONLY by packages/api/src/services/ai.ts for
# reflective prompts and post-hoc "why" text. Never used to compute a number
# shown to a user.
ANTHROPIC_API_KEY=
# Model id for those calls. Short, non-numeric, low-stakes text.
ANTHROPIC_MODEL=claude-sonnet-4-5

# The locating assistant (POST /v1/assistant/locate). Off by default and it
# ships off: it is the first hop where a third party reads a clinician's note
# about a client, so it stays off until the BAA in docs/data-path.md hop 8 is
# signed. With this unset the route returns 503 and no model call is made.
# Setting it requires ANTHROPIC_API_KEY, checked at boot, and a deployment that
# carries docs/theory/ — the system prompt is read from there, not copied.
ASSISTANT_ENABLED=false

# Sentry DSN for the API. Leave empty to disable. PII scrubbing is on
# regardless (packages/api/src/plugins/sentry.ts).
SENTRY_DSN=

# Expo push: needed only if you enforce push security in the Expo dashboard.
# Optional otherwise.
EXPO_ACCESS_TOKEN=

# The API and RLS test suites TRUNCATE every table in DATABASE_MIGRATE_URL.
# They refuse to run against a non-local host unless this names that exact
# host, e.g. aws-0-us-east-2.pooler.supabase.com. It is a hostname and not a
# boolean on purpose: a "1" left in a shell profile or a CI secret would go on
# authorising whatever database .env points at next, while a hostname stops
# being true the moment the target changes. Leave it empty.
ALLOW_DESTRUCTIVE_TESTS=

# Cron schedule for the unresolved-prediction nudge job (node-cron syntax).
# Default: 19:00 in the user's own timezone is computed per user; this is
# the tick frequency of the scheduler.
CRON_NUDGE_TICK=*/15 * * * *

# ----- Expo client (apps/client) --------------------------------------------
# Public values only. Anything prefixed EXPO_PUBLIC_ is bundled into the app.

# Base URL of the API, no trailing slash. Production: https://api.courageloop.com
EXPO_PUBLIC_API_URL=http://localhost:8080

# Supabase project URL and *anon* key (the anon key is public by design;
# RLS is what protects data, never this key).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# EAS project id (from `eas init`). Required for push notifications.
EXPO_PUBLIC_EAS_PROJECT_ID=

# ----- Clinician app (apps/clinician) ---------------------------------------
# Public values only. Anything prefixed NEXT_PUBLIC_ is bundled into the pages.
# The Library needs none of these: those pages carry no client data, are
# prerendered, and stay signed out. Invites and Formulate need all four.

# Base URL of the API, no trailing slash. Production: https://api.courageloop.com
NEXT_PUBLIC_API_URL=http://localhost:8080

# Where the client app lives. Used to assemble the invite link the clinician
# copies, https://<web>/join#<token> — the token goes in the fragment, which
# browsers never send to a server.
# Production: https://app.courageloop.com — this value is what a client
# actually receives, so a wrong one here is a broken invitation, not a warning.
NEXT_PUBLIC_WEB_URL=http://localhost:5173

# Supabase project URL and *anon* key. Same project as the client app; the
# anon key is public by design, and RLS is what protects data, never this key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
