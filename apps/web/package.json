{
  "name": "@ledger/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The milestone-1 client. Offline-first PWA: entries land in IndexedDB and sync when there's a connection.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ledger/shared": "workspace:*",
    "@supabase/supabase-js": "^2.47.10",
    "idb": "^8.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.18.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "@types/react-dom": "~18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.11"
  }
}
